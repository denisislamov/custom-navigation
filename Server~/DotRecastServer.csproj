<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <Jitter2CorePath>$(CanonicalJitterRoot)/Jitter2.Core.dll</Jitter2CorePath>
    <UnsafePath>$(CanonicalJitterRoot)/System.Runtime.CompilerServices.Unsafe.dll</UnsafePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Compile Include="../Runtime/CanonicalJitterContract.cs" Link="Shared/CanonicalJitterContract.cs" />
    <Compile Include="../Runtime/NavigationJitterValidation.cs" Link="Shared/NavigationJitterValidation.cs" />
    <Compile Include="../Runtime/NavigationWireProtocol.cs" Link="Shared/NavigationWireProtocol.cs" />
    <Compile Include="../Runtime/NavigationWireCodec.cs" Link="Shared/NavigationWireCodec.cs" />
    <Reference Include="DotRecast.Core">
      <HintPath>lib/DotRecast.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DotRecast.Detour">
      <HintPath>lib/DotRecast.Detour.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Jitter2.Core" Condition="'$(CanonicalJitterRoot)' != ''">
      <HintPath>$(Jitter2CorePath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe" Condition="'$(CanonicalJitterRoot)' != ''">
      <HintPath>$(UnsafePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireCanonicalJitter" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CanonicalJitterRoot)' == ''"
           Text="CanonicalJitterRoot is required. Extract the approved canonical Jitter release and pass -p:CanonicalJitterRoot=/absolute/path." />
    <Error Condition="!Exists('$(Jitter2CorePath)')"
           Text="Approved Jitter2.Core.dll was not found at $(Jitter2CorePath)." />
    <Error Condition="!Exists('$(UnsafePath)')"
           Text="Pinned Unsafe dependency was not found at $(UnsafePath)." />
  </Target>
</Project>
