<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NavigationDotRecastConformanceProgram.cs" />
    <Compile Include="../../Runtime/CanonicalJitterContract.cs" Link="Shared/CanonicalJitterContract.cs" />
    <Compile Include="../../Runtime/NavigationJitterValidation.cs" Link="Shared/NavigationJitterValidation.cs" />
    <Compile Include="../../Runtime/NavigationDotRecastAdapter.cs" Link="Shared/NavigationDotRecastAdapter.cs" />
    <Compile Include="../../Tests/Shared/NavigationDotRecastConformanceFixtures.cs" Link="Shared/NavigationDotRecastConformanceFixtures.cs" />
    <Reference Include="DotRecast.Core">
      <HintPath>../lib/DotRecast.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Jitter2.Core">
      <HintPath>$(CanonicalJitterRoot)/Jitter2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>$(CanonicalJitterRoot)/System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireCanonicalJitter" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CanonicalJitterRoot)' == ''" Text="CanonicalJitterRoot is required." />
  </Target>
</Project>
