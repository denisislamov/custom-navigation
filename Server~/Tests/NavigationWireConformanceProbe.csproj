<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NavigationWireConformanceProgram.cs" />
    <Compile Include="../../Runtime/NavigationJitterValidation.cs" Link="Shared/NavigationJitterValidation.cs" />
    <Compile Include="../../Runtime/NavigationWireProtocol.cs" Link="Shared/NavigationWireProtocol.cs" />
    <Compile Include="../../Runtime/NavigationWireCodec.cs" Link="Shared/NavigationWireCodec.cs" />
    <Compile Include="../../Tests/Shared/NavigationWireConformanceFixtures.cs" Link="Shared/NavigationWireConformanceFixtures.cs" />
    <Reference Include="Jitter2.Core">
      <HintPath>$(CanonicalJitterRoot)/Jitter2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>$(CanonicalJitterRoot)/System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireCanonicalJitter" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CanonicalJitterRoot)' == ''"
           Text="CanonicalJitterRoot is required." />
    <Error Condition="!Exists('$(CanonicalJitterRoot)/Jitter2.Core.dll')"
           Text="Jitter2.Core.dll is missing from CanonicalJitterRoot." />
  </Target>
</Project>
